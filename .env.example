# Copy to .env beside compose.yaml, or enter these in Dockge's environment editor.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3001
# Keep false for direct HTTP access on your trusted local network.
SECURE_COOKIES=false
# Leave blank for direct local HTTP. For production HTTPS, set the exact origin
# (without a trailing slash) and set SECURE_COOKIES=true above.
PUBLIC_ORIGIN=
# Example: PUBLIC_ORIGIN=https://dnd.everetttang.com
